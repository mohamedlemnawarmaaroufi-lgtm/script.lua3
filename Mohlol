local autoEnabled = false
local currentTarget = nil

-- زر التتبع
local TrackBtn = Instance.new("TextButton")
TrackBtn.Size = UDim2.new(0.85, 0, 0, 45)
TrackBtn.Position = UDim2.new(0.075, 0, 0.35, 0)
