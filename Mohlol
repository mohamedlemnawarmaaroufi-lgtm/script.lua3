TrackBtn.Font = Enum.Font.GothamBold
TrackBtn.TextSize = 18
TrackBtn.Parent = MainFrame
MakeCurvy(TrackBtn, 12)

local function ToggleAuto()
    autoEnabled = not autoEnabled
    
    if autoEnabled then
        TrackBtn.Text = "Auto: ON"
        TrackBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 50)
    else
        TrackBtn.Text = "Auto: OFF"
        TrackBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        currentTarget = nil
        
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                char.Humanoid:MoveTo(root.Position)
            end
        end
    end
end

TrackBtn.MouseButton1Click:Connect(ToggleAuto)

-- حلقة البحث عن الهدف في الخلفية
task.spawn(function()
    while true do
        task.wait(0.1)
        if not autoEnabled then
            currentTarget = nil
            continue
        end

        local char = LocalPlayer.Character
        if not char then continue end

        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then continue end

        local tool = char:FindFirstChildOfClass("Tool")
        if not tool then continue end

        local myPos = root.Position
        local bestTarget = nil
        local bestDist = math.huge

        for _, v in pairs(Players:GetPlayers()) do
            if v == LocalPlayer then continue end
            if not v.Character then continue end

            local tr = v.Character:FindFirstChild("HumanoidRootPart")
            local hum = v.Character:FindFirstChild("Humanoid")

            if not tr then continue end
            if not hum then continue end
            if hum.Health <= 0 then continue end

            local d = (myPos - tr.Position).Magnitude
            if d < bestDist then
                bestDist = d
                bestTarget = v
            end
        end

        currentTarget = bestTarget
    end
end)

-- حلقة تنفيذ الحركة نحو الهدف
RunService.RenderStepped:Connect(function()
    if not autoEnabled then return end

    local char = LocalPlayer.Character
    if not char then return end

    local hum = char:FindFirstChild("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end

    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end

    if currentTarget and currentTarget.Character then
        local targetRoot = currentTarget.Character:FindFirstChild("HumanoidRootPart")
        local targetHum = currentTarget.Character:FindFirstChild("Humanoid")
        if targetRoot and targetHum and targetHum.Health > 0 then
            local targetPos = targetRoot.Position
            hum:MoveTo(targetPos)
            if (root.Position - targetPos).Magnitude < 2 then
                hum:MoveTo(targetPos + targetRoot.CFrame.LookVector * 2)
            end
        end
    end
end)

